# Copy this file to .env.local to override build settings.
# Never put real secrets in a purely static site — there is no backend here.

# Base path Vite uses when building.
# GitHub Pages project site: "/<repo-name>/"   (this repo defaults to /Alisha-Portfolio/)
# Domain-root hosting (Netlify, Vercel, custom domain): "/"
VITE_BASE_PATH=/Alisha-Portfolio/
